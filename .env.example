# Core extraction
# Create this key in your Interfaze account.
INTERFAZE_API_KEY=your_interfaze_api_key

# PostgreSQL (optional)
# Required for price history, alert subscriptions, and scheduled checks.
# DATABASE_URL=postgresql://postgres:change_me@localhost:5432/price_check
#
# If DATABASE_URL does not contain a password, the migration script also
# accepts PostgreSQL's standard PGPASSWORD variable.
# PGPASSWORD=change_me

# Scheduled checks (optional)
# Use a long, random value and send it as: Authorization: Bearer <secret>
# CRON_SECRET=replace_with_a_long_random_secret

# Email alerts (optional)
# Port 587 normally uses STARTTLS with SMTP_SECURE=false.
# Port 465 normally uses implicit TLS with SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password_or_api_key
# SMTP_SECURE=false
# ALERT_FROM="Sift Alerts <alerts@your-domain.com>"

# Local PostgreSQL container (optional)
# These values configure docker-compose.yml. Keep the password in sync with
# DATABASE_URL when using the included PostgreSQL service.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=price_check
# POSTGRES_PORT=5432
